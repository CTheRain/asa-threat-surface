**/*.ucas
**/*.utoc

# Threat surface bulk (stay on S:)
threat-surface/mirror/
threat-surface/extracted/
threat-surface/tools/
**/*ShooterGame-Windows*
**/*pakchunk*

# Python
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Capsule run binaries (manifests + verdicts stay in git)
