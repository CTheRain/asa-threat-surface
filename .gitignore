capsules/**/runs/**/*.arkbak
capsules/**/runs/**/*.arkprofile
capsules/**/runs/**/screenshots/*.png
capsules/**/runs/**/screenshots/*.jpg

# Secrets
.env
*.env
*.token
*api_key*
*xai*

